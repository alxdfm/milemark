# RPC for Arbitrum Sepolia (default) or Anvil
NEXT_PUBLIC_RPC=https://sepolia-rollup.arbitrum.io/rpc

# 421614 = Arbitrum Sepolia (primary). 31337 = local Anvil.
NEXT_PUBLIC_CHAIN_ID=421614

# MilestoneEscrow v3 (new deploy; ABI-incompatible with v2/v1).
# Fill after `forge script script/Deploy.s.sol` on Arbitrum Sepolia.
# Frozen v2 (do not use): 0xdECB21Fd8e835490E5B9Fc26469cE4Cca1F94207
# Obsolete v1 (do not use): 0x72b474DB34268281CD10db655cc1517C33973049
# Override for Anvil after forge script.
NEXT_PUBLIC_ESCROW_ADDRESS=

# Featured demo campaign id on the v3 escrow (after CreateDemo.s.sol).
NEXT_PUBLIC_DEMO_CAMPAIGN_ID=0

# First block to scan for escrow events (Arb Sepolia RPCs reject fromBlock 0).
# Set to the v3 deploy block (or a little before) so the activity feed is cheap.
NEXT_PUBLIC_ESCROW_FROM_BLOCK=309650000

# Circle testnet USDC on Arbitrum Sepolia:
# https://developers.circle.com/stablecoins/usdc-on-test-networks
NEXT_PUBLIC_USDC_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
