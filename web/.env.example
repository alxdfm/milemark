# MileMark web env (Next.js)
#
# Copy to web/.env.local for local overrides (gitignored).
# Production public defaults also live in web/.env.production (tracked, no secrets).
# Vercel dashboard env overrides at build time — NEXT_PUBLIC_* require a rebuild.
# Full matrix: docs/DEPLOY.md
#
# All of these are PUBLIC (inlined into the client). Never put PRIVATE_KEY here.
# There are no server-only secrets; POST /rpc uses NEXT_PUBLIC_RPC.

# Upstream JSON-RPC. On Sepolia the browser calls same-origin POST /rpc, which
# proxies here. On Anvil (CHAIN_ID=31337) the browser talks to this URL directly.
# Example: https://sepolia-rollup.arbitrum.io/rpc
# Required: local optional (Sepolia fallback) / Sepolia optional / Vercel optional
#           Anvil: set to http://127.0.0.1:8545
NEXT_PUBLIC_RPC=https://sepolia-rollup.arbitrum.io/rpc

# 421614 = Arbitrum Sepolia (primary). 31337 = local Anvil (skips /rpc proxy).
# Example: 421614
# Required: local optional (fallback 421614) / Sepolia optional / Vercel optional
#           Anvil: required 31337
NEXT_PUBLIC_CHAIN_ID=421614

# MilestoneEscrow v3. ABI-incompatible with v2/v1 — those addresses disable the UI
# (isEscrowConfigured false → amber banner, no reads/writes).
# Example (live Sepolia): 0xC5A623f9204D3768DDce4aA34137b1eF75D7ADCC
# Production UI: https://milemark-pearl.vercel.app
# Frozen v2 (do not use): 0xdECB21Fd8e835490E5B9Fc26469cE4Cca1F94207
# Obsolete v1 (do not use): 0x72b474DB34268281CD10db655cc1517C33973049
# Required: local optional (fallback LIVE_ESCROW_V3) / Sepolia optional / Vercel optional
#           New deploy or Anvil: required (paste the forge-printed address)
NEXT_PUBLIC_ESCROW_ADDRESS=0xC5A623f9204D3768DDce4aA34137b1eF75D7ADCC

# Featured demo campaign id used by / and /demo.
# Live id 0 is a 1-of-1, 60s window, 3 USDC campaign (create tx
# 0x9eb5776fabb0519e52df8171bf59077898db7124596032b797aced5fef62b4e4, block 309949346).
# That is not the create-form "Judge demo (2-of-3)" template and not CreateDemo.s.sol defaults.
# Required: local optional (fallback "0") / Sepolia optional / Vercel optional
#           After CreateDemo on a new escrow: set to the printed id
NEXT_PUBLIC_DEMO_CAMPAIGN_ID=0

# First block for escrow getLogs (activity timeline). Some providers reject
# fromBlock 0 or huge ranges. Canonical live v3 start: 309949200
# (deploy 309949272; campaign 0 created 309949346).
# Do not use 309949351 for this escrow — it is after CampaignCreated (empty timeline).
# Example: 309949200
# Required: local optional (fallback 309949200) / Sepolia optional / Vercel optional
#           New escrow: required (a few hundred blocks before that deploy)
#           Anvil: 0 is OK
NEXT_PUBLIC_ESCROW_FROM_BLOCK=309949200

# Token the create form approves. Must equal escrow.usdc().
# Example (Circle testnet USDC): 0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
# https://developers.circle.com/stablecoins/usdc-on-test-networks
# Required: local optional (fallback Circle USDC) / Sepolia optional / Vercel optional
#           Anvil: required (MockERC20 address from Deploy.s.sol)
NEXT_PUBLIC_USDC_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
