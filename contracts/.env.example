# MilestoneEscrow deploy env (Foundry)
#
# Copy to contracts/.env (gitignored). Foundry auto-loads .env from this
# directory when you run forge. Full matrix: docs/DEPLOY.md
# Never commit a real PRIVATE_KEY.

# --- Deploy.s.sol ----------------------------------------------------------
# Broadcaster key. Required for Anvil and Sepolia broadcasts.
# Example (Anvil account 0 — PUBLIC test key, never use on a real network):
#   0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Required: local yes / Sepolia yes / Vercel n/a
PRIVATE_KEY=

# Token passed to MilestoneEscrow(usdc_). Ignored when DEPLOY_MOCK_USDC=true.
# Example (Circle testnet USDC on Arbitrum Sepolia):
#   0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
# Required: local no (use mock) / Sepolia yes / Vercel n/a
# Do not point at frozen v2 0xdECB21Fd8e835490E5B9Fc26469cE4Cca1F94207
# or obsolete v1 0x72b474DB34268281CD10db655cc1517C33973049.
USDC_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d

# If true, Deploy.s.sol deploys MockERC20 (6 decimals, public mint) and uses it.
# Example: true
# Required: local yes (true) / Sepolia no (false or unset) / Vercel n/a
DEPLOY_MOCK_USDC=false

# JSON-RPC for Arbitrum Sepolia. Also used by foundry.toml [rpc_endpoints].
# Example: https://sepolia-rollup.arbitrum.io/rpc
# Required: local no / Sepolia recommended (or pass --rpc-url) / Vercel n/a
ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Arbiscan API key for `forge script --verify` (foundry.toml [etherscan]).
# Example: your key from https://arbiscan.io/myapikey
# Required: local no / Sepolia optional / Vercel n/a
ARBISCAN_API_KEY=

# --- CreateDemo.s.sol (after an escrow exists) -----------------------------
# Already-deployed MilestoneEscrow v3. Live Sepolia:
#   0xC5A623f9204D3768DDce4aA34137b1eF75D7ADCC
# Running this script there mints the NEXT id (id 0 already exists: 1-of-1,
# 3 USDC, 60s window — not this script's 4+6 USDC defaults).
# Required: local yes (after Deploy) / Sepolia yes (for this script) / Vercel n/a
# ESCROW_ADDRESS=0xC5A623f9204D3768DDce4aA34137b1eF75D7ADCC

# Optional. Default = the PRIVATE_KEY address (sponsor).
# BENEFICIARY=
# ATTESTOR=

# Optional second attestor. If set and different from ATTESTOR, default QUORUM=2.
# ATTESTOR_2=

# Optional uint8. Default 1, or 2 when ATTESTOR_2 is set.
# Must satisfy 1 <= QUORUM <= unique attestors or createCampaign reverts InvalidQuorum.
# QUORUM=2

# Optional seconds. Default 60.
# CHALLENGE_WINDOW=60

# Optional seconds from now. Default 604800 (7 days).
# DEADLINE_SECONDS=604800

# Sponsor must hold ≥ 10 USDC of escrow.usdc() (hardcoded 4e6 + 6e6). The script approves.
