# MilestoneEscrow deploy env

# Deployer key — never commit a real value. Anvil default account 0 is fine locally:
# 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
PRIVATE_KEY=

# Circle testnet USDC on Arbitrum Sepolia:
# 0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
# v3 is a new deploy. Do not point at frozen v2 0xdECB21Fd8e835490E5B9Fc26469cE4Cca1F94207
# or obsolete v1 0x72b474DB34268281CD10db655cc1517C33973049.
USDC_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d

# Set true on Anvil to deploy MockERC20 instead of using USDC_ADDRESS
DEPLOY_MOCK_USDC=false

ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBISCAN_API_KEY=

